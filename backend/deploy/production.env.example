# Copy to production.env and supply values through the host's secret manager.
# This file contains placeholders only; never commit production.env.
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://<database-user>:<database-password>@<database-hostname>:5432/<database-name>
AUTH_HASH_PEPPER=
FRONTEND_URL=https://<chosen-frontend-hostname>
CORS_ORIGINS=https://<chosen-frontend-hostname>
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
OAUTH_ATTEMPT_TTL_MINUTES=10
# Option A: existing Supabase project with LinkedIn OIDC enabled.
# When either Supabase value is set, Supabase mode is selected and partial configuration fails closed.
SUPABASE_URL=https://<existing-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Option B: direct LinkedIn OIDC. Leave both Supabase values empty when using this option.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://<chosen-backend-hostname>/api/v1/auth/linkedin/callback
# Optional compliant public web search; leave the key empty for honest not_configured discovery.
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
OUTBOUND_TIMEOUT_SECONDS=10
OUTBOUND_MAX_BYTES=1500000
# Keep PAYPAL_ENV=sandbox. Setting live fails closed without explicit future production enablement.
PAYPAL_ENV=sandbox
PAYPAL_LIVE_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_PREMIUM_PLAN_ID=
SERVICE_TERMS_VERSION=2026-11-22
PRIVACY_NOTICE_VERSION=2026-11-22
OPTIONAL_CONSENT_VERSION=2026-11-22