# LOCAL DEVELOPMENT ONLY — do not reuse these values in production.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://hnt:hnt@localhost:5432/hnt
AUTH_HASH_PEPPER=local-only-insecure-hash-pepper-change-me
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
OAUTH_ATTEMPT_TTL_MINUTES=10

# Leave both empty until an operator configures the official LinkedIn application.
# Optional existing Supabase project. Set both to use Supabase linkedin_oidc.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Direct LinkedIn OIDC is used only when both Supabase values are empty.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# Optional compliant public web search for job/contact evidence. No LinkedIn scraping.
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
OUTBOUND_TIMEOUT_SECONDS=10
OUTBOUND_MAX_BYTES=1500000

# PayPal Subscriptions: Sandbox only. Live fails closed unless a future operator enables it in production.
PAYPAL_ENV=sandbox
PAYPAL_LIVE_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_PREMIUM_PLAN_ID=

SERVICE_TERMS_VERSION=2026-11-22
PRIVACY_NOTICE_VERSION=2026-11-22
OPTIONAL_CONSENT_VERSION=2026-11-22